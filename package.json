{
  "name": "motion-blocks",
  "version": "0.5.0",
  "private": true,
  "description": "Add CSS animations to WordPress blocks",
  "homepage": "https://github.com/davewhitley/motion-blocks#readme",
  "bugs": {
    "url": "https://github.com/davewhitley/motion-blocks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davewhitley/motion-blocks.git"
  },
  "license": "GPL-2.0-or-later",
  "author": "Dave Whitley",
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=8.19.2"
  },
  "scripts": {
    "build": "wp-scripts build src/index.js src/frontend.js src/self-check.js src/editor-check.js",
    "start": "wp-scripts start src/index.js src/frontend.js src/self-check.js src/editor-check.js",
    "test:unit": "wp-scripts test-unit-js tests/unit",
    "test:pages": "node tests/self-check/run.mjs",
    "lint:js": "wp-scripts lint-js --ext js,jsx,mjs",
    "lint:css": "wp-scripts lint-style",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "wp-scripts format . \"**/*.mjs\""
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.6",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/icons": "^11.6.0",
    "@wordpress/scripts": "^28.0.0"
  }
}
